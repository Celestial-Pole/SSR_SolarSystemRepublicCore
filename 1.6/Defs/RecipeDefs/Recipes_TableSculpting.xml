<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <RecipeDef ParentName="SSR_RecipeCoreMachining">
        <defName>SSR_Recipe_SculptureSmall</defName>
        <label>制作制作小雕塑</label>
        <description>制作制作小雕塑。</description>
        <jobString>正在制作制作小雕塑。</jobString>
        <workAmount>18000</workAmount>
        <productHasIngredientStuff>true</productHasIngredientStuff>
        <ingredients>
            <li>
                <filter>
                    <stuffCategoriesToAllow>
                        <li>Metallic</li>
                        <li>Woody</li>
                        <li>Stony</li>
                    </stuffCategoriesToAllow>
                </filter>
                <count>50</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <stuffCategoriesToAllow>
                <li>Metallic</li>
                <li>Woody</li>
                <li>Stony</li>
            </stuffCategoriesToAllow>
        </fixedIngredientFilter>
        <defaultIngredientFilter>
            <stuffCategoriesToAllow>
                <li>Metallic</li>
                <li>Woody</li>
                <li>Stony</li>
            </stuffCategoriesToAllow>
            <disallowedThingDefs>
                <li>Gold</li>
                <li>Silver</li>
                <li>Plasteel</li>
                <li>Jade</li>
                <li>Uranium</li>
                <li MayRequire="Ludeon.RimWorld.Anomaly">Bioferrite</li>
                <li MayRequire="Ludeon.RimWorld.Odyssey">Obsidian</li>
            </disallowedThingDefs>
        </defaultIngredientFilter>
        <products>
            <SculptureSmall>1</SculptureSmall>
        </products>
    </RecipeDef>

