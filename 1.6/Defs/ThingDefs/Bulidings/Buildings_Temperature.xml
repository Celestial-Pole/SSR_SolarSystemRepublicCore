<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef ParentName="SSR_BuildingBase_Furniture">
		<defName>SSR_Building_AirConditionerOutdoor</defName>
		<label>空调外机</label>
		<description>空调系统的室外机组，为内机提供制冷能力。</description>
		<tickerType>Rare</tickerType>
		<graphicData>
			<texPath>Things/Building/Temperature/AirCondition/ODU/OutdoorUnit</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>1.2</drawSize>
		</graphicData>
		<size>(1,1)</size>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.5</fillPercent>
		<pathCost>50</pathCost>
		<castEdgeShadows>false</castEdgeShadows>
		<canOverlapZones>false</canOverlapZones>
		<minifiedDef>MinifiedThing</minifiedDef>
		<statBases>
			<MaxHitPoints>250</MaxHitPoints>
			<WorkToBuild>1600</WorkToBuild>
			<Mass>50</Mass>
			<Flammability>0</Flammability>
		</statBases>
		<costList>
			<SSR_Item_SpecialSteel>30</SSR_Item_SpecialSteel>
			<ComponentIndustrial>4</ComponentIndustrial>
		</costList>
		<building>
			<isEdifice>false</isEdifice>
			<destroySound>BuildingDestroyed_Metal_Medium</destroySound>
			<buildingSizeCategory>Small</buildingSizeCategory>
		</building>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>300</basePowerConsumption>
				<shortCircuitInRain>false</shortCircuitInRain>
			</li>
			<li Class="CompProperties_Flickable" />
			<li Class="CompProperties_Breakdownable" />
			<li Class="FS_SSR.TCP_AirConditionerOutdoor">
				<maxSimultaneous>1</maxSimultaneous>
				<maxDistance>999</maxDistance>
				<requiresLOS>false</requiresLOS>
				<linkableBuildings>
					<li>SSR_Building_AirConditionerCabinetIndoor</li>
					<li>SSR_Building_AirConditionerWallIndoor</li>
				</linkableBuildings>
				<levelSettings>
					<li>
						<heatExchangeEnergyPerSecond>42</heatExchangeEnergyPerSecond>
						<maxPowerConsumption>200</maxPowerConsumption>
						<lowPowerConsumptionFactor>0.1</lowPowerConsumptionFactor>
						<hotSideEnergyFactor>1.25</hotSideEnergyFactor>
						<efficiencyLossPerDegreeDiff>0.007692308</efficiencyLossPerDegreeDiff>
						<powerResponseExponent>1</powerResponseExponent>
					</li>
					<li>
						<heatExchangeEnergyPerSecond>84</heatExchangeEnergyPerSecond>
						<maxPowerConsumption>300</maxPowerConsumption>
						<lowPowerConsumptionFactor>0.1</lowPowerConsumptionFactor>
						<hotSideEnergyFactor>1.25</hotSideEnergyFactor>
						<efficiencyLossPerDegreeDiff>0.007692308</efficiencyLossPerDegreeDiff>
						<powerResponseExponent>1</powerResponseExponent>
					</li>
				</levelSettings>
			</li>
			<li Class="FS_SSR.Generic.TCP_Upgradable">
				<levels>
					<li>
						<key>1</key>
						<value>
							<graphicData>
								<texPath>Things/Building/Temperature/AirCondition/ODU/T2OutdoorUnit</texPath>
								<graphicClass>Graphic_Multi</graphicClass>
								<shaderType>CutoutComplex</shaderType>
								<drawSize>(1.3,1.3)</drawSize>
							</graphicData>
							<workAmt>1600</workAmt>
							<requireMaterial>true</requireMaterial>
							<requirePawnWork>true</requirePawnWork>
							<requireResearch>SSR_Research_Medium-levelPowerTechnology</requireResearch>
							<materials>
								<li>
									<item>SSR_Item_Carbyne</item>
									<amount>20</amount>
								</li>
								<li>
									<item>SSR_Item_NanoandMicroMechanicalComposite</item>
									<amount>30</amount>
								</li>
								<li>
									<item>ComponentSpacer</item>
									<amount>4</amount>
								</li>
							</materials>
						</value>
					</li>
				</levels>
			</li>
		</comps>
		<placeWorkers>
			<li>FS_SSR.PW_AirConditionerOutdoor</li>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
			<li>FS_SSR.UI.PW_FrameLevel</li>
		</placeWorkers>
		<researchPrerequisites>
			<li>SSR_Research_BasicPowerTechnology</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
		<uiOrder>10</uiOrder>
		<modExtensions Inherit="False">
			<li Class="FS_SSR.UI.Ext_DesignationCategoryInner">
				<innerCategory>SSR_DesignationInnerCategory_Temperature</innerCategory>
			</li>
		</modExtensions>
	</ThingDef>

	<ThingDef ParentName="SSR_BuildingBase_Furniture">
		<defName>SSR_Building_AirConditionerWallIndoor</defName>
		<label>壁式空调内机</label>
		<description>安装在室内墙面上的空调内机。需要与一台空调外机连接才能工作。</description>
		<tickerType>Rare</tickerType>
		<graphicData>
			<texPath>Things/Building/Temperature/AirCondition/IDU/WallMounted/WallMounted</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(1.125,0.75)</drawSize>
			<drawOffsetNorth>(0,0,0.738)</drawOffsetNorth>
			<drawOffsetSouth>(0,0,-0.351)</drawOffsetSouth>
			<drawOffsetWest>(-0.548,0,0)</drawOffsetWest>
			<drawOffsetEast>(0.634,0,0)</drawOffsetEast>
		</graphicData>
		<size>(1,1)</size>
		<uiIconScale>1.5</uiIconScale>
		<altitudeLayer>BuildingOnTop</altitudeLayer>
		<passability>Standable</passability>
		<terrainAffordanceNeeded IsNull="True" />
		<fillPercent>0.1</fillPercent>
		<pathCost>0</pathCost>
		<castEdgeShadows>false</castEdgeShadows>
		<canOverlapZones>true</canOverlapZones>
		<minifiedDef>MinifiedThing</minifiedDef>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<WorkToBuild>800</WorkToBuild>
			<Mass>15</Mass>
			<Flammability>0</Flammability>
		</statBases>
		<costList>
			<SSR_Item_SpecialSteel>10</SSR_Item_SpecialSteel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<building>
			<isEdifice>false</isEdifice>
			<isAttachment>true</isAttachment>
			<destroySound>BuildingDestroyed_Metal_Small</destroySound>
			<buildingSizeCategory>Small</buildingSizeCategory>
		</building>
		<comps>
			<li Class="FS_SSR.TCP_AirConditionerIndoor">
				<energyPerSecond>42</energyPerSecond>
				<levelSettings>
					<li>
						<heatExchangeFactor>2</heatExchangeFactor>
					</li>
					<li>
						<heatExchangeFactor>6</heatExchangeFactor>
					</li>
				</levelSettings>
			</li>
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
					<li>SSR_Building_AirConditionerOutdoor</li>
				</linkableFacilities>
			</li>
			<li Class="FS_SSR.Generic.TCP_Upgradable">
				<levels>
					<li>
						<key>1</key>
						<value>
							<graphicData>
								<texPath>Things/Building/Temperature/AirCondition/IDU/WallMounted/T2WallMounted</texPath>
								<graphicClass>Graphic_Multi</graphicClass>
								<shaderType>CutoutComplex</shaderType>
								<drawSize>(1.125,0.75)</drawSize>
								<drawOffsetNorth>(0,0,0.9)</drawOffsetNorth>
								<drawOffsetSouth>(0,0,-0.9)</drawOffsetSouth>
								<drawOffsetWest>(-0.9,0,0)</drawOffsetWest>
								<drawOffsetEast>(0.9,0,0)</drawOffsetEast>
							</graphicData>
							<workAmt>800</workAmt>
							<requireMaterial>true</requireMaterial>
							<requirePawnWork>true</requirePawnWork>
							<requireResearch>SSR_Research_Medium-levelPowerTechnology</requireResearch>
							<materials>
								<li>
									<item>SSR_Item_Carbyne</item>
									<amount>10</amount>
								</li>
								<li>
									<item>SSR_Item_NanoandMicroMechanicalComposite</item>
									<amount>15</amount>
								</li>
								<li>
									<item>ComponentSpacer</item>
									<amount>2</amount>
								</li>
							</materials>
						</value>
					</li>
				</levels>
			</li>
		</comps>
		<placeWorkers>
			<li>FS_SSR.PW_AirConditionerIndoorWall</li>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
			<li>FS_SSR.UI.PW_FrameLevel</li>
		</placeWorkers>
		<researchPrerequisites>
			<li>SSR_Research_BasicPowerTechnology</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>4</constructionSkillPrerequisite>
		<uiOrder>20</uiOrder>
		<modExtensions Inherit="False">
			<li Class="FS_SSR.UI.Ext_DesignationCategoryInner">
				<innerCategory>SSR_DesignationInnerCategory_Temperature</innerCategory>
			</li>
		</modExtensions>
	</ThingDef>

	<ThingDef ParentName="SSR_BuildingBase_Furniture">
		<defName>SSR_Building_AirConditionerCabinetIndoor</defName>
		<label>柜式空调内机</label>
		<description>放置在室内的柜式空调内机。需要与一台空调外机连接才能工作。</description>
		<graphicData>
			<texPath>Things/Building/Temperature/AirCondition/IDU/Cabinet/Cabinet</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>2</drawSize>
			<drawOffset>(0,0,0.5)</drawOffset>
		</graphicData>
		<size>(1,1)</size>
		<uiIconScale>0.75</uiIconScale>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.35</fillPercent>
		<pathCost>30</pathCost>
		<castEdgeShadows>false</castEdgeShadows>
		<canOverlapZones>false</canOverlapZones>
		<minifiedDef>MinifiedThing</minifiedDef>
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<WorkToBuild>1200</WorkToBuild>
			<Mass>35</Mass>
			<Flammability>0</Flammability>
		</statBases>
		<costList>
			<SSR_Item_SpecialSteel>20</SSR_Item_SpecialSteel>
			<ComponentIndustrial>3</ComponentIndustrial>
		</costList>
		<building>
			<isEdifice>false</isEdifice>
			<destroySound>BuildingDestroyed_Metal_Small</destroySound>
			<buildingSizeCategory>Small</buildingSizeCategory>
		</building>
		<comps>
			<li Class="FS_SSR.TCP_AirConditionerIndoor">
				<energyPerSecond>42</energyPerSecond>
				<!--制冷能力-->
				<lowPowerConsumptionFactor>0.1</lowPowerConsumptionFactor>
				<!--待机功耗系数-->
				<levelSettings>
					<li>
						<!-- T1制冷效率 -->
						<heatExchangeFactor>4</heatExchangeFactor>
					</li>
					<li>
						<heatExchangeFactor>12</heatExchangeFactor>
					</li>
				</levelSettings>
			</li>
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
					<li>SSR_Building_AirConditionerOutdoor</li>
				</linkableFacilities>
			</li>
			<li Class="FS_SSR.Generic.TCP_Upgradable">
				<levels>
					<li>
						<key>1</key>
						<value>
							<graphicData>
								<texPath>Things/Building/Temperature/AirCondition/IDU/Cabinet/T2Cabinet</texPath>
								<graphicClass>Graphic_Multi</graphicClass>
								<shaderType>CutoutComplex</shaderType>
								<drawSize>2</drawSize>
								<drawOffset>(0,0,0.5)</drawOffset>
							</graphicData>
							<workAmt>1000</workAmt>
							<requireMaterial>true</requireMaterial>
							<requirePawnWork>true</requirePawnWork>
							<requireResearch>SSR_Research_Medium-levelPowerTechnology</requireResearch>
							<materials>
								<li>
									<item>SSR_Item_Carbyne</item>
									<amount>20</amount>
								</li>
								<li>
									<item>SSR_Item_NanoandMicroMechanicalComposite</item>
									<amount>30</amount>
								</li>
								<li>
									<item>ComponentSpacer</item>
									<amount>4</amount>
								</li>
							</materials>
						</value>
					</li>
				</levels>
			</li>
		</comps>
		<placeWorkers>
			<li>FS_SSR.PW_AirConditionerIndoorFloor</li>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
		</placeWorkers>
		<researchPrerequisites>
			<li>SSR_Research_BasicPowerTechnology</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>4</constructionSkillPrerequisite>
		<uiOrder>30</uiOrder>
		<modExtensions Inherit="False">
			<!--TODO-->
			<li Class="FS_SSR.UI.Ext_DesignationCategoryInner">
				<innerCategory>SSR_DesignationInnerCategory_Temperature</innerCategory>
			</li>
		</modExtensions>
	</ThingDef>

	<ThingDef ParentName="SSR_BuildingBase_Furniture">
		<defName>SSR_Building_TemperatureController</defName>
		<label>温度控制装置</label>
		<description>desc。</description>
		<thingClass>FS_SSR.Building_SingleTempController</thingClass>
		<tickerType>Rare</tickerType>
		<graphicData>
			<texPath>Things/Building/Temperature/TempController/TempController_south</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>1</drawSize>
		</graphicData>
		<size>(1,1)</size>
		<rotatable>false</rotatable>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.35</fillPercent>
		<pathCost>30</pathCost>
		<castEdgeShadows>false</castEdgeShadows>
		<canOverlapZones>false</canOverlapZones>
		<minifiedDef>MinifiedThing</minifiedDef>
		<statBases>
			<MaxHitPoints>180</MaxHitPoints>
			<WorkToBuild>1200</WorkToBuild>
			<Mass>35</Mass>
			<Flammability>0</Flammability>
		</statBases>
		<costList>
			<SSR_Item_SpecialSteel>20</SSR_Item_SpecialSteel>
			<ComponentIndustrial>3</ComponentIndustrial>
		</costList>
		<building>
			<isEdifice>false</isEdifice>
			<destroySound>BuildingDestroyed_Metal_Small</destroySound>
			<buildingSizeCategory>Small</buildingSizeCategory>
		</building>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>200</basePowerConsumption>
				<shortCircuitInRain>false</shortCircuitInRain>
			</li>
			<li Class="CompProperties_Flickable" />
			<li Class="FS_SSR.TCP_SingleTempController">
				<!--功耗 x10 =实际制冷效果-->
				<coefficientOfPerformance>10</coefficientOfPerformance>
				<defaultTargetTemperature>21</defaultTargetTemperature>
				<lowPowerConsumptionFactor>0.1</lowPowerConsumptionFactor>
			</li>
			<li Class="CompProperties_Breakdownable" />
		</comps>
		<researchPrerequisites>
			<li>SSR_Research_BasicPowerTechnology</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>4</constructionSkillPrerequisite>
		<uiOrder>40</uiOrder>
		<modExtensions Inherit="False">
			<li Class="FS_SSR.UI.Ext_DesignationCategoryInner">
				<innerCategory>SSR_DesignationInnerCategory_Temperature</innerCategory>
			</li>
		</modExtensions>
	</ThingDef>

</Defs>
